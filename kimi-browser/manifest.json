{
  "manifest_version": 3,
  "name": "Dianna.ai",
  "version": "0.26.2",
  "description": "Dianna.ai — AI agent na nakikita at kayang kontrolin ang sariling tab group.",
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "notifications",
    "alarms",
    "scripting",
    "sidePanel",
    "activeTab",
    "tabCapture",
    "offscreen",
    "downloads",
    "identity",
    "unlimitedStorage"
  ],
  "host_permissions": ["https://api.kimi.com/*", "https://api.groq.com/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Buksan ang Dianna" }
}
